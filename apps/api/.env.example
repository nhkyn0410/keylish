# =============================================================================
# apps/api/.env — cấu hình API cho DEV local.
# KHÔNG đặt DATABASE_URL ở đây — kết nối DB nằm ở packages/db/.env (được load
# với override). Giá trị production đặt trên Render (xem render.yaml).
# =============================================================================

PORT=3000

# Origin trình duyệt được phép gửi request có cookie.
# Dev tự cho phép localhost:3001 + localhost:3002 → để trống khi chạy local.
# Trên Render: đặt thành origin user-web, vd https://keylish-web.vercel.app
# AUTH_ALLOWED_ORIGINS=https://keylish-web.vercel.app

# BẮT BUỘC ở production (không có thì API không boot). Chuỗi bí mật dài, ngẫu nhiên.
AUTH_TOKEN_PEPPER=change-me-at-least-32-random-chars

# Cookie SameSite: lax | strict | none.
# Để trống → tự chọn: "none" ở production (web/API khác domain), "lax" ở local.
# Chỉ set "lax" nếu web + API chung một domain gốc (vd app.x.com + api.x.com).
# AUTH_COOKIE_SAMESITE=none

AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
USER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Seed admin đầu tiên: pnpm --filter @keylish/api seed-admin <user> <pass>
# (hoặc set 2 biến dưới rồi chạy không tham số).
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-seeding

# Gửi email reset (tuỳ chọn). Thiếu RESEND_API_KEY + AUTH_RESET_EMAIL_FROM thì
# link reset chỉ được ghi ra log server. WEB_APP_URL = origin user-web để dựng link.
WEB_APP_URL=http://localhost:3001
# RESEND_API_KEY=re_xxx
# AUTH_RESET_EMAIL_FROM=KeyLish <no-reply@your-domain.com>

# Admin API là local-only (xem doc/v2.1.1-admin-local.md). Để trống ở dev = bật;
# trên Render bị ép tắt qua render.yaml.
# ADMIN_API_ENABLED=true

# Lộ token reset (chỉ dev). Giữ false/trống ở production.
# AUTH_EXPOSE_RESET_TOKEN=true
