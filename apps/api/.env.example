DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keylish
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keylish
PORT=3001

# Comma-separated browser origins allowed to send credentialed requests.
# In development, localhost:3000 and localhost:3002 are allowed when unset.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# REQUIRED in production (boot fails without it). Long random secret.
AUTH_TOKEN_PEPPER=change-me-at-least-32-random-chars

# Cookie SameSite policy: lax | strict | none.
# Leave unset to auto-pick: "none" in production (web and API on different
# domains, e.g. Vercel + Render) and "lax" locally. Set "lax" explicitly only if
# web and API share one parent domain (e.g. app.x.com + api.x.com).
# AUTH_COOKIE_SAMESITE=none

AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
USER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-seeding

# Password-reset email delivery. Without RESEND_API_KEY + AUTH_RESET_EMAIL_FROM
# the reset link is logged server-side instead of emailed.
# WEB_APP_URL is the user-web origin used to build the reset link.
WEB_APP_URL=http://localhost:3000
# RESEND_API_KEY=re_xxx
# AUTH_RESET_EMAIL_FROM=KeyLish <no-reply@your-domain.com>

# Optional dev-only reset token exposure. Keep false/empty in production.
# AUTH_EXPOSE_RESET_TOKEN=true
