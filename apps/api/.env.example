DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keylish
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keylish
PORT=3001

# Comma-separated browser origins allowed to send credentialed requests.
# In development, localhost:3000 and localhost:3002 are allowed when unset.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

AUTH_TOKEN_PEPPER=change-me-at-least-32-random-chars
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
USER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-before-seeding

# Optional dev-only reset token exposure. Keep false/empty in production.
# AUTH_EXPOSE_RESET_TOKEN=true
