# =============================================================================
# Root .env — CHỈ dùng cho `docker compose` (Postgres + pgAdmin local).
# Không có gì khác đọc file này. Cấu hình app nằm ở nơi khác:
#   • DB (DATABASE_URL/DIRECT_URL) → packages/db/.env
#   • API (PORT, AUTH_*, ADMIN_INITIAL_*, ...) → apps/api/.env
#   • Web (NEXT_PUBLIC_API_URL) → apps/user-web/.env, apps/admin-web/.env
# Production: đặt env trên dashboard Render / Vercel, KHÔNG dùng file .env.
# =============================================================================

POSTGRES_DB=keylish
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@keylish.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Muốn dùng Postgres local này, trỏ packages/db/.env vào nó:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keylish
#   DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keylish
