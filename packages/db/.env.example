# Kết nối DB DEV LOCAL — NGUỒN DUY NHẤT cho DATABASE_URL / DIRECT_URL khi chạy máy dev.
# Đọc bởi: API runtime (ghi đè apps/api/.env), Prisma CLI (migrate/generate/studio),
# seed vocab, và seed-admin.
#
# KHÔNG đặt Supabase production URL vào file local này.
# Production: cấu hình DATABASE_URL/DIRECT_URL trực tiếp trên Render dashboard.

# Postgres local (docker compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keylish
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keylish
