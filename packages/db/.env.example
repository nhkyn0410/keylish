# Kết nối DB — NGUỒN DUY NHẤT cho DATABASE_URL / DIRECT_URL.
# Đọc bởi: API runtime (ghi đè apps/api/.env), Prisma CLI (migrate/generate),
# và script seed-admin.

# Postgres local (docker compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keylish
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/keylish

# Ví dụ production Supabase (pooler):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
