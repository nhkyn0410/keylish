{
  "name": "@keylish/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "node scripts/guard-db-env.mjs dev-write && prisma migrate dev --schema prisma/schema.prisma",
    "deploy": "node scripts/guard-db-env.mjs deploy && prisma migrate deploy --schema prisma/schema.prisma",
    "format": "prisma format --schema prisma/schema.prisma",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "studio": "node scripts/guard-db-env.mjs dev-readwrite && prisma studio --config prisma.config.ts --browser none"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
