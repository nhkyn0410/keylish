{
  "name": "keylish",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "// development": "Local development servers",
    "dev": "turbo dev --parallel",
    "dev:user-web": "pnpm --filter @keylish/user-web dev",
    "dev:admin-web": "pnpm --filter @keylish/admin-web dev",
    "dev:api": "pnpm --filter @keylish/api dev",
    "// quality": "Build, lint, typecheck, test, and formatting",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "pnpm lint && pnpm typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "// database": "Prisma database helpers",
    "db:generate": "pnpm --filter @keylish/db generate",
    "db:migrate": "pnpm --filter @keylish/db migrate",
    "db:deploy": "pnpm --filter @keylish/db run deploy",
    "db:studio": "pnpm --filter @keylish/db studio",
    "// docker": "Local Docker Compose helpers",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "sharp": "^0.35.0",
    "turbo": "^2.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
